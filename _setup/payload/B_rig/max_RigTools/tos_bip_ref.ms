struct TOS_BipRefStruct (
	fn mk x = (local d = x[2]; local p = filterString x[1] "_"; TOS_BipRefItem key:x[1] job:p[1] g:d[1] file:d[2] height:d[3] h:d[4] spine:d[5] neck:d[6] fingers:d[7] fingerLinks:d[8] toes:d[9] toeLinks:d[10] triNeck:d[11] triPelvis:d[12] prop2:d[13] twist:d[14] ankle:d[15] bodyType:d[16] layer:d[17] twistLayer:d[18] thick:d[19] chast:x[3]),
	-- 직업_성별 (job 이 없거나 그 직업 데이터가 없으면 같은 성별 첫 데이터)
	fn get g job:undefined = (local r = undefined, k = if job != undefined then (job + "_" + (g as string)) else ""; for x in TOS_BipRefData while r == undefined do if x[1] == k do r = x; if r == undefined do for x in TOS_BipRefData while r == undefined do if x[2][1] == g do r = x; if r == undefined then undefined else (mk r)),
	fn keys = (for x in TOS_BipRefData collect x[1])
)
global TOS_BipRef = TOS_BipRefStruct()
